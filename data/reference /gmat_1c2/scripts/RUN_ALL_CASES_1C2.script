% CASE-GMAT-EOP-1C2-C01-LOW-350KM-I1-FEB-6H two_body
Create Spacecraft C01TBSat;
C01TBSat.DateFormat = UTCGregorian;
C01TBSat.Epoch = '11 Feb 2026 03:17:00.000';
C01TBSat.CoordinateSystem = EarthMJ2000Eq;
C01TBSat.DisplayStateType = Cartesian;
C01TBSat.X = -6738.026452274639269;
C01TBSat.Y = -117.788239929651468;
C01TBSat.Z = 20.423332232526711;
C01TBSat.VX = 0.114529584323189;
C01TBSat.VY = -7.682495189076065;
C01TBSat.VZ = -0.132016136404040;
C01TBSat.DryMass = 500;
C01TBSat.Cd = 2.2;
C01TBSat.Cr = 1.0;
C01TBSat.DragArea = 4;
C01TBSat.SRPArea = 4;

Create ForceModel C01TBFM;
C01TBFM.CentralBody = Earth;
C01TBFM.PrimaryBodies = {Earth};
C01TBFM.Drag = None;
C01TBFM.SRP = Off;
C01TBFM.RelativisticCorrection = Off;
C01TBFM.ErrorControl = RSSStep;
C01TBFM.GravityField.Earth.Degree = 0;
C01TBFM.GravityField.Earth.Order = 0;
C01TBFM.GravityField.Earth.PotentialFile = 'JGM2.cof';
C01TBFM.GravityField.Earth.TideModel = 'None';

Create Propagator C01TBProp;
C01TBProp.FM = C01TBFM;
C01TBProp.Type = PrinceDormand78;
C01TBProp.InitialStepSize = 60;
C01TBProp.Accuracy = 1e-13;
C01TBProp.MinStep = 1e-6;
C01TBProp.MaxStep = 60;
C01TBProp.MaxStepAttempts = 50;
C01TBProp.StopIfAccuracyIsViolated = true;

Create EphemerisFile C01TBEph;
C01TBEph.Spacecraft = C01TBSat;
C01TBEph.Filename = './data/reference/gmat_1c2/output/C01_LOW_350KM_I1_FEB_6H_TWO_BODY.e';
C01TBEph.FileFormat = STK-TimePosVel;
C01TBEph.EpochFormat = UTCGregorian;
C01TBEph.InitialEpoch = InitialSpacecraftEpoch;
C01TBEph.FinalEpoch = FinalSpacecraftEpoch;
C01TBEph.StepSize = 60;
C01TBEph.Interpolator = Lagrange;
C01TBEph.InterpolationOrder = 7;
C01TBEph.CoordinateSystem = EarthMJ2000Eq;
C01TBEph.WriteEphemeris = true;

