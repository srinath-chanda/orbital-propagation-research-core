% Research Core 1D.2 fallback individual full-arc case/model

% D05_RETRO_1200KM_I120_AUG_48H / G2020 degree 20, order 20
Create Spacecraft D05G2020Sat;
D05G2020Sat.DateFormat = UTCGregorian;
D05G2020Sat.Epoch = '04 Aug 2026 18:52:00.000';
D05G2020Sat.CoordinateSystem = EarthMJ2000Eq;
D05G2020Sat.DisplayStateType = Cartesian;
D05G2020Sat.X = -3065.082388116592938;
D05G2020Sat.Y = -2145.806194253081685;
D05G2020Sat.Z = 6464.810856862644869;
D05G2020Sat.VX = -3.854526439523131;
D05G2020Sat.VY = 6.265296487411957;
D05G2020Sat.VZ = 0.133554596141119;
D05G2020Sat.DryMass = 500;
D05G2020Sat.Cd = 2.2;
D05G2020Sat.Cr = 1.0;
D05G2020Sat.DragArea = 4;
D05G2020Sat.SRPArea = 4;

Create ForceModel D05G2020FM;
D05G2020FM.CentralBody = Earth;
D05G2020FM.PrimaryBodies = {Earth};
D05G2020FM.Drag = None;
D05G2020FM.SRP = Off;
D05G2020FM.RelativisticCorrection = Off;
D05G2020FM.ErrorControl = RSSStep;
D05G2020FM.GravityField.Earth.Degree = 20;
D05G2020FM.GravityField.Earth.Order = 20;
D05G2020FM.GravityField.Earth.PotentialFile = './data/reference/gmat_r2026a/JGM2.cof';
D05G2020FM.GravityField.Earth.TideModel = 'None';

Create Propagator D05G2020Prop;
D05G2020Prop.FM = D05G2020FM;
D05G2020Prop.Type = PrinceDormand78;
D05G2020Prop.InitialStepSize = 60;
D05G2020Prop.Accuracy = 1e-13;
D05G2020Prop.MinStep = 1e-6;
D05G2020Prop.MaxStep = 60;
D05G2020Prop.MaxStepAttempts = 50;
D05G2020Prop.StopIfAccuracyIsViolated = true;

Create EphemerisFile D05G2020Eph;
D05G2020Eph.Spacecraft = D05G2020Sat;
D05G2020Eph.Filename = './data/reference/gmat_1d2/output/D05_RETRO_1200KM_I120_AUG_48H_G2020.e';
D05G2020Eph.FileFormat = STK-TimePosVel;
D05G2020Eph.EpochFormat = UTCGregorian;
D05G2020Eph.InitialEpoch = InitialSpacecraftEpoch;
D05G2020Eph.FinalEpoch = FinalSpacecraftEpoch;
D05G2020Eph.StepSize = 60;
D05G2020Eph.Interpolator = Lagrange;
D05G2020Eph.InterpolationOrder = 7;
D05G2020Eph.CoordinateSystem = EarthMJ2000Eq;
D05G2020Eph.WriteEphemeris = true;

BeginMissionSequence;
Propagate D05G2020Prop(D05G2020Sat) {D05G2020Sat.ElapsedSecs = 172800};
