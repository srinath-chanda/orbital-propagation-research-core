% Research Core 1D.1 fallback individual short arc

% G2020: degree 20, order 20
Create Spacecraft G2020Sat;
G2020Sat.DateFormat = UTCGregorian;
G2020Sat.Epoch = '01 Jan 2026 00:00:00.000';
G2020Sat.CoordinateSystem = EarthMJ2000Eq;
G2020Sat.DisplayStateType = Cartesian;
G2020Sat.X = 4791.244801771758830;
G2020Sat.Y = 3981.843847094183275;
G2020Sat.Z = 2653.334545050801353;
G2020Sat.VX = -5.018943360359614;
G2020Sat.VY = 2.567534615772381;
G2020Sat.VZ = 5.209846002826843;
G2020Sat.DryMass = 500;
G2020Sat.Cd = 2.2;
G2020Sat.Cr = 1.0;
G2020Sat.DragArea = 4;
G2020Sat.SRPArea = 4;

Create ForceModel G2020FM;
G2020FM.CentralBody = Earth;
G2020FM.PrimaryBodies = {Earth};
G2020FM.Drag = None;
G2020FM.SRP = Off;
G2020FM.RelativisticCorrection = Off;
G2020FM.ErrorControl = RSSStep;
G2020FM.GravityField.Earth.Degree = 20;
G2020FM.GravityField.Earth.Order = 20;
G2020FM.GravityField.Earth.PotentialFile = './data/reference/gmat_r2026a/JGM2.cof';
G2020FM.GravityField.Earth.TideModel = 'None';

Create Propagator G2020Prop;
G2020Prop.FM = G2020FM;
G2020Prop.Type = PrinceDormand78;
G2020Prop.InitialStepSize = 10;
G2020Prop.Accuracy = 1e-13;
G2020Prop.MinStep = 1e-6;
G2020Prop.MaxStep = 10;
G2020Prop.MaxStepAttempts = 50;
G2020Prop.StopIfAccuracyIsViolated = true;

Create EphemerisFile G2020Eph;
G2020Eph.Spacecraft = G2020Sat;
G2020Eph.Filename = './data/reference/gmat_1d1/output/G2020_SHORT_ARC.e';
G2020Eph.FileFormat = STK-TimePosVel;
G2020Eph.EpochFormat = UTCGregorian;
G2020Eph.InitialEpoch = InitialSpacecraftEpoch;
G2020Eph.FinalEpoch = FinalSpacecraftEpoch;
G2020Eph.StepSize = 10;
G2020Eph.Interpolator = Lagrange;
G2020Eph.InterpolationOrder = 7;
G2020Eph.CoordinateSystem = EarthMJ2000Eq;
G2020Eph.WriteEphemeris = true;

BeginMissionSequence;
Propagate G2020Prop(G2020Sat) {G2020Sat.ElapsedSecs = 1800};
