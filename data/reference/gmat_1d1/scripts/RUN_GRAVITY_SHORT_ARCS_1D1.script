%
% Research Core 1D.1 higher-degree/order short-arc matrix
% Target GMAT R2026a; frozen JGM2; 30 minutes; 10-second outputs.
% Run once. Thresholds were preregistered before these outputs.
%

% G20: degree 2, order 0
Create Spacecraft G20Sat;
G20Sat.DateFormat = UTCGregorian;
G20Sat.Epoch = '01 Jan 2026 00:00:00.000';
G20Sat.CoordinateSystem = EarthMJ2000Eq;
G20Sat.DisplayStateType = Cartesian;
G20Sat.X = 4791.244801771758830;
G20Sat.Y = 3981.843847094183275;
G20Sat.Z = 2653.334545050801353;
G20Sat.VX = -5.018943360359614;
G20Sat.VY = 2.567534615772381;
G20Sat.VZ = 5.209846002826843;
G20Sat.DryMass = 500;
G20Sat.Cd = 2.2;
G20Sat.Cr = 1.0;
G20Sat.DragArea = 4;
G20Sat.SRPArea = 4;

Create ForceModel G20FM;
G20FM.CentralBody = Earth;
G20FM.PrimaryBodies = {Earth};
G20FM.Drag = None;
G20FM.SRP = Off;
G20FM.RelativisticCorrection = Off;
G20FM.ErrorControl = RSSStep;
G20FM.GravityField.Earth.Degree = 2;
G20FM.GravityField.Earth.Order = 0;
G20FM.GravityField.Earth.PotentialFile = './data/reference/gmat_r2026a/JGM2.cof';
G20FM.GravityField.Earth.TideModel = 'None';

Create Propagator G20Prop;
G20Prop.FM = G20FM;
G20Prop.Type = PrinceDormand78;
G20Prop.InitialStepSize = 10;
G20Prop.Accuracy = 1e-13;
G20Prop.MinStep = 1e-6;
G20Prop.MaxStep = 10;
G20Prop.MaxStepAttempts = 50;
G20Prop.StopIfAccuracyIsViolated = true;

Create EphemerisFile G20Eph;
G20Eph.Spacecraft = G20Sat;
G20Eph.Filename = './data/reference/gmat_1d1/output/G20_SHORT_ARC.e';
G20Eph.FileFormat = STK-TimePosVel;
G20Eph.EpochFormat = UTCGregorian;
G20Eph.InitialEpoch = InitialSpacecraftEpoch;
G20Eph.FinalEpoch = FinalSpacecraftEpoch;
G20Eph.StepSize = 10;
G20Eph.Interpolator = Lagrange;
G20Eph.InterpolationOrder = 7;
G20Eph.CoordinateSystem = EarthMJ2000Eq;
G20Eph.WriteEphemeris = true;

