BeginMissionSequence;
Propagate G20Prop(G20Sat) {G20Sat.ElapsedSecs = 1800};
Propagate G44Prop(G44Sat) {G44Sat.ElapsedSecs = 1800};
Propagate G88Prop(G88Sat) {G88Sat.ElapsedSecs = 1800};
Propagate G2020Prop(G2020Sat) {G2020Sat.ElapsedSecs = 1800};
