% Research Core 1D.1 fallback individual short arc

% G88: degree 8, order 8
Create Spacecraft G88Sat;
G88Sat.DateFormat = UTCGregorian;
G88Sat.Epoch = '01 Jan 2026 00:00:00.000';
G88Sat.CoordinateSystem = EarthMJ2000Eq;
G88Sat.DisplayStateType = Cartesian;
G88Sat.X = 4791.244801771758830;
G88Sat.Y = 3981.843847094183275;
G88Sat.Z = 2653.334545050801353;
G88Sat.VX = -5.018943360359614;
G88Sat.VY = 2.567534615772381;
G88Sat.VZ = 5.209846002826843;
G88Sat.DryMass = 500;
G88Sat.Cd = 2.2;
G88Sat.Cr = 1.0;
G88Sat.DragArea = 4;
G88Sat.SRPArea = 4;

Create ForceModel G88FM;
G88FM.CentralBody = Earth;
G88FM.PrimaryBodies = {Earth};
G88FM.Drag = None;
G88FM.SRP = Off;
G88FM.RelativisticCorrection = Off;
G88FM.ErrorControl = RSSStep;
G88FM.GravityField.Earth.Degree = 8;
G88FM.GravityField.Earth.Order = 8;
G88FM.GravityField.Earth.PotentialFile = './data/reference/gmat_r2026a/JGM2.cof';
G88FM.GravityField.Earth.TideModel = 'None';

Create Propagator G88Prop;
G88Prop.FM = G88FM;
G88Prop.Type = PrinceDormand78;
G88Prop.InitialStepSize = 10;
G88Prop.Accuracy = 1e-13;
G88Prop.MinStep = 1e-6;
G88Prop.MaxStep = 10;
G88Prop.MaxStepAttempts = 50;
G88Prop.StopIfAccuracyIsViolated = true;

Create EphemerisFile G88Eph;
G88Eph.Spacecraft = G88Sat;
G88Eph.Filename = './data/reference/gmat_1d1/output/G88_SHORT_ARC.e';
G88Eph.FileFormat = STK-TimePosVel;
G88Eph.EpochFormat = UTCGregorian;
G88Eph.InitialEpoch = InitialSpacecraftEpoch;
G88Eph.FinalEpoch = FinalSpacecraftEpoch;
G88Eph.StepSize = 10;
G88Eph.Interpolator = Lagrange;
G88Eph.InterpolationOrder = 7;
G88Eph.CoordinateSystem = EarthMJ2000Eq;
G88Eph.WriteEphemeris = true;

BeginMissionSequence;
Propagate G88Prop(G88Sat) {G88Sat.ElapsedSecs = 1800};
