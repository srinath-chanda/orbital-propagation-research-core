%
% Research Core 1D.0 higher-degree/order shared-state gravity ladder
% Target: GMAT R2026a; JGM2; no tides, drag, SRP, third bodies, or relativity.
%

Create Spacecraft LadderSat;
LadderSat.DateFormat = UTCGregorian;
LadderSat.Epoch = '01 Jan 2026 00:00:00.000';
LadderSat.CoordinateSystem = EarthMJ2000Eq;
LadderSat.DisplayStateType = Cartesian;
LadderSat.X = 4791.244801771758830;
LadderSat.Y = 3981.843847094183275;
LadderSat.Z = 2653.334545050801353;
LadderSat.VX = -5.018943360359614;
LadderSat.VY = 2.567534615772381;
LadderSat.VZ = 5.209846002826843;
LadderSat.DryMass = 500;
LadderSat.Cd = 2.2;
LadderSat.Cr = 1.0;
LadderSat.DragArea = 4;
LadderSat.SRPArea = 4;

Create ForceModel G00FM;
G00FM.CentralBody = Earth;
G00FM.PrimaryBodies = {Earth};
G00FM.Drag = None;
G00FM.SRP = Off;
G00FM.RelativisticCorrection = Off;
G00FM.ErrorControl = RSSStep;
G00FM.GravityField.Earth.Degree = 0;
G00FM.GravityField.Earth.Order = 0;
G00FM.GravityField.Earth.PotentialFile = './data/reference/gmat_r2026a/JGM2.cof';
G00FM.GravityField.Earth.TideModel = 'None';

Create ForceModel G20FM;
G20FM.CentralBody = Earth;
G20FM.PrimaryBodies = {Earth};
G20FM.Drag = None;
G20FM.SRP = Off;
G20FM.RelativisticCorrection = Off;
G20FM.ErrorControl = RSSStep;
G20FM.GravityField.Earth.Degree = 2;
G20FM.GravityField.Earth.Order = 0;
G20FM.GravityField.Earth.PotentialFile = './data/reference/gmat_r2026a/JGM2.cof';
G20FM.GravityField.Earth.TideModel = 'None';

Create ForceModel G40FM;
G40FM.CentralBody = Earth;
G40FM.PrimaryBodies = {Earth};
G40FM.Drag = None;
G40FM.SRP = Off;
G40FM.RelativisticCorrection = Off;
G40FM.ErrorControl = RSSStep;
G40FM.GravityField.Earth.Degree = 4;
G40FM.GravityField.Earth.Order = 0;
G40FM.GravityField.Earth.PotentialFile = './data/reference/gmat_r2026a/JGM2.cof';
G40FM.GravityField.Earth.TideModel = 'None';

Create ForceModel G44FM;
G44FM.CentralBody = Earth;
G44FM.PrimaryBodies = {Earth};
G44FM.Drag = None;
G44FM.SRP = Off;
G44FM.RelativisticCorrection = Off;
G44FM.ErrorControl = RSSStep;
G44FM.GravityField.Earth.Degree = 4;
G44FM.GravityField.Earth.Order = 4;
G44FM.GravityField.Earth.PotentialFile = './data/reference/gmat_r2026a/JGM2.cof';
G44FM.GravityField.Earth.TideModel = 'None';

Create ForceModel G88FM;
G88FM.CentralBody = Earth;
G88FM.PrimaryBodies = {Earth};
G88FM.Drag = None;
G88FM.SRP = Off;
G88FM.RelativisticCorrection = Off;
G88FM.ErrorControl = RSSStep;
G88FM.GravityField.Earth.Degree = 8;
G88FM.GravityField.Earth.Order = 8;
G88FM.GravityField.Earth.PotentialFile = './data/reference/gmat_r2026a/JGM2.cof';
G88FM.GravityField.Earth.TideModel = 'None';

Create ForceModel G2020FM;
G2020FM.CentralBody = Earth;
G2020FM.PrimaryBodies = {Earth};
G2020FM.Drag = None;
G2020FM.SRP = Off;
G2020FM.RelativisticCorrection = Off;
G2020FM.ErrorControl = RSSStep;
G2020FM.GravityField.Earth.Degree = 20;
G2020FM.GravityField.Earth.Order = 20;
G2020FM.GravityField.Earth.PotentialFile = './data/reference/gmat_r2026a/JGM2.cof';
G2020FM.GravityField.Earth.TideModel = 'None';

Create Propagator LadderProp;
LadderProp.FM = G2020FM;
LadderProp.Type = PrinceDormand78;
LadderProp.InitialStepSize = 75;
LadderProp.Accuracy = 1e-13;
LadderProp.MinStep = 1e-6;
LadderProp.MaxStep = 75;
LadderProp.MaxStepAttempts = 50;
LadderProp.StopIfAccuracyIsViolated = true;

Create ReportFile GravityLadderReport;
GravityLadderReport.Filename = './data/reference/gmat_1d0/output/GMAT_GRAVITY_LADDER_1D0.csv';
GravityLadderReport.Precision = 16;
GravityLadderReport.ColumnWidth = 24;
GravityLadderReport.WriteHeaders = true;
GravityLadderReport.LeftJustify = Off;
GravityLadderReport.ZeroFill = On;
GravityLadderReport.FixedWidth = Off;
GravityLadderReport.Delimiter = Comma;

BeginMissionSequence;
Report GravityLadderReport LadderSat.ElapsedSecs LadderSat.EarthMJ2000Eq.X LadderSat.EarthMJ2000Eq.Y LadderSat.EarthMJ2000Eq.Z LadderSat.G00FM.AccelerationX LadderSat.G00FM.AccelerationY LadderSat.G00FM.AccelerationZ LadderSat.G20FM.AccelerationX LadderSat.G20FM.AccelerationY LadderSat.G20FM.AccelerationZ LadderSat.G40FM.AccelerationX LadderSat.G40FM.AccelerationY LadderSat.G40FM.AccelerationZ LadderSat.G44FM.AccelerationX LadderSat.G44FM.AccelerationY LadderSat.G44FM.AccelerationZ LadderSat.G88FM.AccelerationX LadderSat.G88FM.AccelerationY LadderSat.G88FM.AccelerationZ LadderSat.G2020FM.AccelerationX LadderSat.G2020FM.AccelerationY LadderSat.G2020FM.AccelerationZ;
Propagate LadderProp(LadderSat) {LadderSat.ElapsedSecs = 75};
Report GravityLadderReport LadderSat.ElapsedSecs LadderSat.EarthMJ2000Eq.X LadderSat.EarthMJ2000Eq.Y LadderSat.EarthMJ2000Eq.Z LadderSat.G00FM.AccelerationX LadderSat.G00FM.AccelerationY LadderSat.G00FM.AccelerationZ LadderSat.G20FM.AccelerationX LadderSat.G20FM.AccelerationY LadderSat.G20FM.AccelerationZ LadderSat.G40FM.AccelerationX LadderSat.G40FM.AccelerationY LadderSat.G40FM.AccelerationZ LadderSat.G44FM.AccelerationX LadderSat.G44FM.AccelerationY LadderSat.G44FM.AccelerationZ LadderSat.G88FM.AccelerationX LadderSat.G88FM.AccelerationY LadderSat.G88FM.AccelerationZ LadderSat.G2020FM.AccelerationX LadderSat.G2020FM.AccelerationY LadderSat.G2020FM.AccelerationZ;
Propagate LadderProp(LadderSat) {LadderSat.ElapsedSecs = 75};
Report GravityLadderReport LadderSat.ElapsedSecs LadderSat.EarthMJ2000Eq.X LadderSat.EarthMJ2000Eq.Y LadderSat.EarthMJ2000Eq.Z LadderSat.G00FM.AccelerationX LadderSat.G00FM.AccelerationY LadderSat.G00FM.AccelerationZ LadderSat.G20FM.AccelerationX LadderSat.G20FM.AccelerationY LadderSat.G20FM.AccelerationZ LadderSat.G40FM.AccelerationX LadderSat.G40FM.AccelerationY LadderSat.G40FM.AccelerationZ LadderSat.G44FM.AccelerationX LadderSat.G44FM.AccelerationY LadderSat.G44FM.AccelerationZ LadderSat.G88FM.AccelerationX LadderSat.G88FM.AccelerationY LadderSat.G88FM.AccelerationZ LadderSat.G2020FM.AccelerationX LadderSat.G2020FM.AccelerationY LadderSat.G2020FM.AccelerationZ;
