% Research Core 1E.0 fallback single ballistic scenario

% AREA_X2: isolated exponential drag at shared gravity-only states
Create Spacecraft DGA2Sat;
DGA2Sat.DateFormat = UTCGregorian;
DGA2Sat.Epoch = '01 Jan 2026 00:00:00.000';
DGA2Sat.CoordinateSystem = EarthMJ2000Eq;
DGA2Sat.DisplayStateType = Cartesian;
DGA2Sat.X = 4791.244801771758830;
DGA2Sat.Y = 3981.843847094183275;
DGA2Sat.Z = 2653.334545050801353;
DGA2Sat.VX = -5.018943360359614;
DGA2Sat.VY = 2.567534615772381;
DGA2Sat.VZ = 5.209846002826843;
DGA2Sat.DryMass = 500;
DGA2Sat.Cd = 2.2;
DGA2Sat.Cr = 1.0;
DGA2Sat.DragArea = 8;
DGA2Sat.SRPArea = 4.0;
DGA2Sat.AtmosDensityScaleFactor = 1.0;

Create ForceModel DGA2GravityFM;
DGA2GravityFM.CentralBody = Earth;
DGA2GravityFM.PrimaryBodies = {Earth};
DGA2GravityFM.Drag = None;
DGA2GravityFM.SRP = Off;
DGA2GravityFM.RelativisticCorrection = Off;
DGA2GravityFM.ErrorControl = RSSStep;
DGA2GravityFM.GravityField.Earth.Degree = 20;
DGA2GravityFM.GravityField.Earth.Order = 20;
DGA2GravityFM.GravityField.Earth.PotentialFile = './data/reference/gmat_r2026a/JGM2.cof';
DGA2GravityFM.GravityField.Earth.TideModel = 'None';

Create ForceModel DGA2DragFM;
DGA2DragFM.CentralBody = Earth;
DGA2DragFM.PrimaryBodies = {Earth};
DGA2DragFM.Drag.AtmosphereModel = Exponential;
DGA2DragFM.Drag.DragModel = 'Spherical';
DGA2DragFM.Drag.InputFile = './data/reference/gmat_r2026a/EarthExponentialAtmosphereData.txt';
DGA2DragFM.SRP = Off;
DGA2DragFM.RelativisticCorrection = Off;
DGA2DragFM.ErrorControl = RSSStep;
DGA2DragFM.GravityField.Earth.Degree = 20;
DGA2DragFM.GravityField.Earth.Order = 20;
DGA2DragFM.GravityField.Earth.PotentialFile = './data/reference/gmat_r2026a/JGM2.cof';
DGA2DragFM.GravityField.Earth.TideModel = 'None';

Create Propagator DGA2Prop;
DGA2Prop.FM = DGA2GravityFM;
DGA2Prop.Type = PrinceDormand78;
DGA2Prop.InitialStepSize = 50;
DGA2Prop.Accuracy = 1e-13;
DGA2Prop.MinStep = 1e-06;
DGA2Prop.MaxStep = 50;
DGA2Prop.MaxStepAttempts = 50;
DGA2Prop.StopIfAccuracyIsViolated = true;

Create ReportFile DGA2Report;
DGA2Report.Filename = './data/reference/gmat_1e0/output/AREA_X2_DRAG_ACCELERATION_1E0.csv';
DGA2Report.Precision = 16;
DGA2Report.ColumnWidth = 24;
DGA2Report.WriteHeaders = true;
DGA2Report.LeftJustify = Off;
DGA2Report.ZeroFill = On;
DGA2Report.FixedWidth = Off;
DGA2Report.Delimiter = Comma;

BeginMissionSequence;
Report DGA2Report DGA2Sat.ElapsedSecs DGA2Sat.EarthMJ2000Eq.X DGA2Sat.EarthMJ2000Eq.Y DGA2Sat.EarthMJ2000Eq.Z DGA2Sat.EarthMJ2000Eq.VX DGA2Sat.EarthMJ2000Eq.VY DGA2Sat.EarthMJ2000Eq.VZ DGA2Sat.DGA2GravityFM.AccelerationX DGA2Sat.DGA2GravityFM.AccelerationY DGA2Sat.DGA2GravityFM.AccelerationZ DGA2Sat.DGA2DragFM.AccelerationX DGA2Sat.DGA2DragFM.AccelerationY DGA2Sat.DGA2DragFM.AccelerationZ;
Propagate DGA2Prop(DGA2Sat) {DGA2Sat.ElapsedSecs = 50};
Report DGA2Report DGA2Sat.ElapsedSecs DGA2Sat.EarthMJ2000Eq.X DGA2Sat.EarthMJ2000Eq.Y DGA2Sat.EarthMJ2000Eq.Z DGA2Sat.EarthMJ2000Eq.VX DGA2Sat.EarthMJ2000Eq.VY DGA2Sat.EarthMJ2000Eq.VZ DGA2Sat.DGA2GravityFM.AccelerationX DGA2Sat.DGA2GravityFM.AccelerationY DGA2Sat.DGA2GravityFM.AccelerationZ DGA2Sat.DGA2DragFM.AccelerationX DGA2Sat.DGA2DragFM.AccelerationY DGA2Sat.DGA2DragFM.AccelerationZ;
Propagate DGA2Prop(DGA2Sat) {DGA2Sat.ElapsedSecs = 50};
Report DGA2Report DGA2Sat.ElapsedSecs DGA2Sat.EarthMJ2000Eq.X DGA2Sat.EarthMJ2000Eq.Y DGA2Sat.EarthMJ2000Eq.Z DGA2Sat.EarthMJ2000Eq.VX DGA2Sat.EarthMJ2000Eq.VY DGA2Sat.EarthMJ2000Eq.VZ DGA2Sat.DGA2GravityFM.AccelerationX DGA2Sat.DGA2GravityFM.AccelerationY DGA2Sat.DGA2GravityFM.AccelerationZ DGA2Sat.DGA2DragFM.AccelerationX DGA2Sat.DGA2DragFM.AccelerationY DGA2Sat.DGA2DragFM.AccelerationZ;
