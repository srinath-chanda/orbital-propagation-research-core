% Research Core 1E.0 fallback single ballistic scenario

% MASS_HALF: isolated exponential drag at shared gravity-only states
Create Spacecraft DGM2Sat;
DGM2Sat.DateFormat = UTCGregorian;
DGM2Sat.Epoch = '01 Jan 2026 00:00:00.000';
DGM2Sat.CoordinateSystem = EarthMJ2000Eq;
DGM2Sat.DisplayStateType = Cartesian;
DGM2Sat.X = 4791.244801771758830;
DGM2Sat.Y = 3981.843847094183275;
DGM2Sat.Z = 2653.334545050801353;
DGM2Sat.VX = -5.018943360359614;
DGM2Sat.VY = 2.567534615772381;
DGM2Sat.VZ = 5.209846002826843;
DGM2Sat.DryMass = 250;
DGM2Sat.Cd = 2.2;
DGM2Sat.Cr = 1.0;
DGM2Sat.DragArea = 4;
DGM2Sat.SRPArea = 4.0;
DGM2Sat.AtmosDensityScaleFactor = 1.0;

Create ForceModel DGM2GravityFM;
DGM2GravityFM.CentralBody = Earth;
DGM2GravityFM.PrimaryBodies = {Earth};
DGM2GravityFM.Drag = None;
DGM2GravityFM.SRP = Off;
DGM2GravityFM.RelativisticCorrection = Off;
DGM2GravityFM.ErrorControl = RSSStep;
DGM2GravityFM.GravityField.Earth.Degree = 20;
DGM2GravityFM.GravityField.Earth.Order = 20;
DGM2GravityFM.GravityField.Earth.PotentialFile = './data/reference/gmat_r2026a/JGM2.cof';
DGM2GravityFM.GravityField.Earth.TideModel = 'None';

Create ForceModel DGM2DragFM;
DGM2DragFM.CentralBody = Earth;
DGM2DragFM.PrimaryBodies = {Earth};
DGM2DragFM.Drag.AtmosphereModel = Exponential;
DGM2DragFM.Drag.DragModel = 'Spherical';
DGM2DragFM.Drag.InputFile = './data/reference/gmat_r2026a/EarthExponentialAtmosphereData.txt';
DGM2DragFM.SRP = Off;
DGM2DragFM.RelativisticCorrection = Off;
DGM2DragFM.ErrorControl = RSSStep;
DGM2DragFM.GravityField.Earth.Degree = 20;
DGM2DragFM.GravityField.Earth.Order = 20;
DGM2DragFM.GravityField.Earth.PotentialFile = './data/reference/gmat_r2026a/JGM2.cof';
DGM2DragFM.GravityField.Earth.TideModel = 'None';

Create Propagator DGM2Prop;
DGM2Prop.FM = DGM2GravityFM;
DGM2Prop.Type = PrinceDormand78;
DGM2Prop.InitialStepSize = 50;
DGM2Prop.Accuracy = 1e-13;
DGM2Prop.MinStep = 1e-06;
DGM2Prop.MaxStep = 50;
DGM2Prop.MaxStepAttempts = 50;
DGM2Prop.StopIfAccuracyIsViolated = true;

Create ReportFile DGM2Report;
DGM2Report.Filename = './data/reference/gmat_1e0/output/MASS_HALF_DRAG_ACCELERATION_1E0.csv';
DGM2Report.Precision = 16;
DGM2Report.ColumnWidth = 24;
DGM2Report.WriteHeaders = true;
DGM2Report.LeftJustify = Off;
DGM2Report.ZeroFill = On;
DGM2Report.FixedWidth = Off;
DGM2Report.Delimiter = Comma;

BeginMissionSequence;
Report DGM2Report DGM2Sat.ElapsedSecs DGM2Sat.EarthMJ2000Eq.X DGM2Sat.EarthMJ2000Eq.Y DGM2Sat.EarthMJ2000Eq.Z DGM2Sat.EarthMJ2000Eq.VX DGM2Sat.EarthMJ2000Eq.VY DGM2Sat.EarthMJ2000Eq.VZ DGM2Sat.DGM2GravityFM.AccelerationX DGM2Sat.DGM2GravityFM.AccelerationY DGM2Sat.DGM2GravityFM.AccelerationZ DGM2Sat.DGM2DragFM.AccelerationX DGM2Sat.DGM2DragFM.AccelerationY DGM2Sat.DGM2DragFM.AccelerationZ;
Propagate DGM2Prop(DGM2Sat) {DGM2Sat.ElapsedSecs = 50};
Report DGM2Report DGM2Sat.ElapsedSecs DGM2Sat.EarthMJ2000Eq.X DGM2Sat.EarthMJ2000Eq.Y DGM2Sat.EarthMJ2000Eq.Z DGM2Sat.EarthMJ2000Eq.VX DGM2Sat.EarthMJ2000Eq.VY DGM2Sat.EarthMJ2000Eq.VZ DGM2Sat.DGM2GravityFM.AccelerationX DGM2Sat.DGM2GravityFM.AccelerationY DGM2Sat.DGM2GravityFM.AccelerationZ DGM2Sat.DGM2DragFM.AccelerationX DGM2Sat.DGM2DragFM.AccelerationY DGM2Sat.DGM2DragFM.AccelerationZ;
Propagate DGM2Prop(DGM2Sat) {DGM2Sat.ElapsedSecs = 50};
Report DGM2Report DGM2Sat.ElapsedSecs DGM2Sat.EarthMJ2000Eq.X DGM2Sat.EarthMJ2000Eq.Y DGM2Sat.EarthMJ2000Eq.Z DGM2Sat.EarthMJ2000Eq.VX DGM2Sat.EarthMJ2000Eq.VY DGM2Sat.EarthMJ2000Eq.VZ DGM2Sat.DGM2GravityFM.AccelerationX DGM2Sat.DGM2GravityFM.AccelerationY DGM2Sat.DGM2GravityFM.AccelerationZ DGM2Sat.DGM2DragFM.AccelerationX DGM2Sat.DGM2DragFM.AccelerationY DGM2Sat.DGM2DragFM.AccelerationZ;
Propagate DGM2Prop(DGM2Sat) {DGM2Sat.ElapsedSecs = 50};
