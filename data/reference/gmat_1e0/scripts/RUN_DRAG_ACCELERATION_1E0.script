Report DGNReport DGNSat.ElapsedSecs DGNSat.EarthMJ2000Eq.X DGNSat.EarthMJ2000Eq.Y DGNSat.EarthMJ2000Eq.Z DGNSat.EarthMJ2000Eq.VX DGNSat.EarthMJ2000Eq.VY DGNSat.EarthMJ2000Eq.VZ DGNSat.DGNGravityFM.AccelerationX DGNSat.DGNGravityFM.AccelerationY DGNSat.DGNGravityFM.AccelerationZ DGNSat.DGNDragFM.AccelerationX DGNSat.DGNDragFM.AccelerationY DGNSat.DGNDragFM.AccelerationZ;
