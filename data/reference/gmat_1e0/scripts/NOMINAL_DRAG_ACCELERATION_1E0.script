% Research Core 1E.0 fallback single ballistic scenario

% NOMINAL: isolated exponential drag at shared gravity-only states
Create Spacecraft DGNSat;
DGNSat.DateFormat = UTCGregorian;
DGNSat.Epoch = '01 Jan 2026 00:00:00.000';
DGNSat.CoordinateSystem = EarthMJ2000Eq;
DGNSat.DisplayStateType = Cartesian;
DGNSat.X = 4791.244801771758830;
DGNSat.Y = 3981.843847094183275;
DGNSat.Z = 2653.334545050801353;
DGNSat.VX = -5.018943360359614;
DGNSat.VY = 2.567534615772381;
DGNSat.VZ = 5.209846002826843;
DGNSat.DryMass = 500;
DGNSat.Cd = 2.2;
DGNSat.Cr = 1.0;
DGNSat.DragArea = 4;
DGNSat.SRPArea = 4.0;
DGNSat.AtmosDensityScaleFactor = 1.0;

Create ForceModel DGNGravityFM;
DGNGravityFM.CentralBody = Earth;
DGNGravityFM.PrimaryBodies = {Earth};
DGNGravityFM.Drag = None;
DGNGravityFM.SRP = Off;
DGNGravityFM.RelativisticCorrection = Off;
DGNGravityFM.ErrorControl = RSSStep;
DGNGravityFM.GravityField.Earth.Degree = 20;
DGNGravityFM.GravityField.Earth.Order = 20;
DGNGravityFM.GravityField.Earth.PotentialFile = './data/reference/gmat_r2026a/JGM2.cof';
DGNGravityFM.GravityField.Earth.TideModel = 'None';

Create ForceModel DGNDragFM;
DGNDragFM.CentralBody = Earth;
DGNDragFM.PrimaryBodies = {Earth};
DGNDragFM.Drag.AtmosphereModel = Exponential;
DGNDragFM.Drag.DragModel = 'Spherical';
DGNDragFM.Drag.InputFile = './data/reference/gmat_r2026a/EarthExponentialAtmosphereData.txt';
DGNDragFM.SRP = Off;
DGNDragFM.RelativisticCorrection = Off;
DGNDragFM.ErrorControl = RSSStep;
DGNDragFM.GravityField.Earth.Degree = 20;
DGNDragFM.GravityField.Earth.Order = 20;
DGNDragFM.GravityField.Earth.PotentialFile = './data/reference/gmat_r2026a/JGM2.cof';
DGNDragFM.GravityField.Earth.TideModel = 'None';

Create Propagator DGNProp;
DGNProp.FM = DGNGravityFM;
DGNProp.Type = PrinceDormand78;
DGNProp.InitialStepSize = 50;
DGNProp.Accuracy = 1e-13;
DGNProp.MinStep = 1e-06;
DGNProp.MaxStep = 50;
DGNProp.MaxStepAttempts = 50;
DGNProp.StopIfAccuracyIsViolated = true;

Create ReportFile DGNReport;
DGNReport.Filename = './data/reference/gmat_1e0/output/NOMINAL_DRAG_ACCELERATION_1E0.csv';
DGNReport.Precision = 16;
DGNReport.ColumnWidth = 24;
DGNReport.WriteHeaders = true;
DGNReport.LeftJustify = Off;
DGNReport.ZeroFill = On;
DGNReport.FixedWidth = Off;
DGNReport.Delimiter = Comma;

BeginMissionSequence;
Report DGNReport DGNSat.ElapsedSecs DGNSat.EarthMJ2000Eq.X DGNSat.EarthMJ2000Eq.Y DGNSat.EarthMJ2000Eq.Z DGNSat.EarthMJ2000Eq.VX DGNSat.EarthMJ2000Eq.VY DGNSat.EarthMJ2000Eq.VZ DGNSat.DGNGravityFM.AccelerationX DGNSat.DGNGravityFM.AccelerationY DGNSat.DGNGravityFM.AccelerationZ DGNSat.DGNDragFM.AccelerationX DGNSat.DGNDragFM.AccelerationY DGNSat.DGNDragFM.AccelerationZ;
Propagate DGNProp(DGNSat) {DGNSat.ElapsedSecs = 50};
Report DGNReport DGNSat.ElapsedSecs DGNSat.EarthMJ2000Eq.X DGNSat.EarthMJ2000Eq.Y DGNSat.EarthMJ2000Eq.Z DGNSat.EarthMJ2000Eq.VX DGNSat.EarthMJ2000Eq.VY DGNSat.EarthMJ2000Eq.VZ DGNSat.DGNGravityFM.AccelerationX DGNSat.DGNGravityFM.AccelerationY DGNSat.DGNGravityFM.AccelerationZ DGNSat.DGNDragFM.AccelerationX DGNSat.DGNDragFM.AccelerationY DGNSat.DGNDragFM.AccelerationZ;
Propagate DGNProp(DGNSat) {DGNSat.ElapsedSecs = 50};
Report DGNReport DGNSat.ElapsedSecs DGNSat.EarthMJ2000Eq.X DGNSat.EarthMJ2000Eq.Y DGNSat.EarthMJ2000Eq.Z DGNSat.EarthMJ2000Eq.VX DGNSat.EarthMJ2000Eq.VY DGNSat.EarthMJ2000Eq.VZ DGNSat.DGNGravityFM.AccelerationX DGNSat.DGNGravityFM.AccelerationY DGNSat.DGNGravityFM.AccelerationZ DGNSat.DGNDragFM.AccelerationX DGNSat.DGNDragFM.AccelerationY DGNSat.DGNDragFM.AccelerationZ;
Propagate DGNProp(DGNSat) {DGNSat.ElapsedSecs = 50};
Report DGNReport DGNSat.ElapsedSecs DGNSat.EarthMJ2000Eq.X DGNSat.EarthMJ2000Eq.Y DGNSat.EarthMJ2000Eq.Z DGNSat.EarthMJ2000Eq.VX DGNSat.EarthMJ2000Eq.VY DGNSat.EarthMJ2000Eq.VZ DGNSat.DGNGravityFM.AccelerationX DGNSat.DGNGravityFM.AccelerationY DGNSat.DGNGravityFM.AccelerationZ DGNSat.DGNDragFM.AccelerationX DGNSat.DGNDragFM.AccelerationY DGNSat.DGNDragFM.AccelerationZ;
Propagate DGNProp(DGNSat) {DGNSat.ElapsedSecs = 50};
Report DGNReport DGNSat.ElapsedSecs DGNSat.EarthMJ2000Eq.X DGNSat.EarthMJ2000Eq.Y DGNSat.EarthMJ2000Eq.Z DGNSat.EarthMJ2000Eq.VX DGNSat.EarthMJ2000Eq.VY DGNSat.EarthMJ2000Eq.VZ DGNSat.DGNGravityFM.AccelerationX DGNSat.DGNGravityFM.AccelerationY DGNSat.DGNGravityFM.AccelerationZ DGNSat.DGNDragFM.AccelerationX DGNSat.DGNDragFM.AccelerationY DGNSat.DGNDragFM.AccelerationZ;
Propagate DGNProp(DGNSat) {DGNSat.ElapsedSecs = 50};
Report DGNReport DGNSat.ElapsedSecs DGNSat.EarthMJ2000Eq.X DGNSat.EarthMJ2000Eq.Y DGNSat.EarthMJ2000Eq.Z DGNSat.EarthMJ2000Eq.VX DGNSat.EarthMJ2000Eq.VY DGNSat.EarthMJ2000Eq.VZ DGNSat.DGNGravityFM.AccelerationX DGNSat.DGNGravityFM.AccelerationY DGNSat.DGNGravityFM.AccelerationZ DGNSat.DGNDragFM.AccelerationX DGNSat.DGNDragFM.AccelerationY DGNSat.DGNDragFM.AccelerationZ;
Propagate DGNProp(DGNSat) {DGNSat.ElapsedSecs = 50};
Report DGNReport DGNSat.ElapsedSecs DGNSat.EarthMJ2000Eq.X DGNSat.EarthMJ2000Eq.Y DGNSat.EarthMJ2000Eq.Z DGNSat.EarthMJ2000Eq.VX DGNSat.EarthMJ2000Eq.VY DGNSat.EarthMJ2000Eq.VZ DGNSat.DGNGravityFM.AccelerationX DGNSat.DGNGravityFM.AccelerationY DGNSat.DGNGravityFM.AccelerationZ DGNSat.DGNDragFM.AccelerationX DGNSat.DGNDragFM.AccelerationY DGNSat.DGNDragFM.AccelerationZ;
Propagate DGNProp(DGNSat) {DGNSat.ElapsedSecs = 50};
Report DGNReport DGNSat.ElapsedSecs DGNSat.EarthMJ2000Eq.X DGNSat.EarthMJ2000Eq.Y DGNSat.EarthMJ2000Eq.Z DGNSat.EarthMJ2000Eq.VX DGNSat.EarthMJ2000Eq.VY DGNSat.EarthMJ2000Eq.VZ DGNSat.DGNGravityFM.AccelerationX DGNSat.DGNGravityFM.AccelerationY DGNSat.DGNGravityFM.AccelerationZ DGNSat.DGNDragFM.AccelerationX DGNSat.DGNDragFM.AccelerationY DGNSat.DGNDragFM.AccelerationZ;
Propagate DGNProp(DGNSat) {DGNSat.ElapsedSecs = 50};
Report DGNReport DGNSat.ElapsedSecs DGNSat.EarthMJ2000Eq.X DGNSat.EarthMJ2000Eq.Y DGNSat.EarthMJ2000Eq.Z DGNSat.EarthMJ2000Eq.VX DGNSat.EarthMJ2000Eq.VY DGNSat.EarthMJ2000Eq.VZ DGNSat.DGNGravityFM.AccelerationX DGNSat.DGNGravityFM.AccelerationY DGNSat.DGNGravityFM.AccelerationZ DGNSat.DGNDragFM.AccelerationX DGNSat.DGNDragFM.AccelerationY DGNSat.DGNDragFM.AccelerationZ;
Propagate DGNProp(DGNSat) {DGNSat.ElapsedSecs = 50};
Report DGNReport DGNSat.ElapsedSecs DGNSat.EarthMJ2000Eq.X DGNSat.EarthMJ2000Eq.Y DGNSat.EarthMJ2000Eq.Z DGNSat.EarthMJ2000Eq.VX DGNSat.EarthMJ2000Eq.VY DGNSat.EarthMJ2000Eq.VZ DGNSat.DGNGravityFM.AccelerationX DGNSat.DGNGravityFM.AccelerationY DGNSat.DGNGravityFM.AccelerationZ DGNSat.DGNDragFM.AccelerationX DGNSat.DGNDragFM.AccelerationY DGNSat.DGNDragFM.AccelerationZ;
Propagate DGNProp(DGNSat) {DGNSat.ElapsedSecs = 50};
Report DGNReport DGNSat.ElapsedSecs DGNSat.EarthMJ2000Eq.X DGNSat.EarthMJ2000Eq.Y DGNSat.EarthMJ2000Eq.Z DGNSat.EarthMJ2000Eq.VX DGNSat.EarthMJ2000Eq.VY DGNSat.EarthMJ2000Eq.VZ DGNSat.DGNGravityFM.AccelerationX DGNSat.DGNGravityFM.AccelerationY DGNSat.DGNGravityFM.AccelerationZ DGNSat.DGNDragFM.AccelerationX DGNSat.DGNDragFM.AccelerationY DGNSat.DGNDragFM.AccelerationZ;
Propagate DGNProp(DGNSat) {DGNSat.ElapsedSecs = 50};
Report DGNReport DGNSat.ElapsedSecs DGNSat.EarthMJ2000Eq.X DGNSat.EarthMJ2000Eq.Y DGNSat.EarthMJ2000Eq.Z DGNSat.EarthMJ2000Eq.VX DGNSat.EarthMJ2000Eq.VY DGNSat.EarthMJ2000Eq.VZ DGNSat.DGNGravityFM.AccelerationX DGNSat.DGNGravityFM.AccelerationY DGNSat.DGNGravityFM.AccelerationZ DGNSat.DGNDragFM.AccelerationX DGNSat.DGNDragFM.AccelerationY DGNSat.DGNDragFM.AccelerationZ;
Propagate DGNProp(DGNSat) {DGNSat.ElapsedSecs = 50};
Report DGNReport DGNSat.ElapsedSecs DGNSat.EarthMJ2000Eq.X DGNSat.EarthMJ2000Eq.Y DGNSat.EarthMJ2000Eq.Z DGNSat.EarthMJ2000Eq.VX DGNSat.EarthMJ2000Eq.VY DGNSat.EarthMJ2000Eq.VZ DGNSat.DGNGravityFM.AccelerationX DGNSat.DGNGravityFM.AccelerationY DGNSat.DGNGravityFM.AccelerationZ DGNSat.DGNDragFM.AccelerationX DGNSat.DGNDragFM.AccelerationY DGNSat.DGNDragFM.AccelerationZ;
