% Research Core 1E.0 fallback single ballistic scenario

% CD_HALF: isolated exponential drag at shared gravity-only states
Create Spacecraft DGC5Sat;
DGC5Sat.DateFormat = UTCGregorian;
DGC5Sat.Epoch = '01 Jan 2026 00:00:00.000';
DGC5Sat.CoordinateSystem = EarthMJ2000Eq;
DGC5Sat.DisplayStateType = Cartesian;
DGC5Sat.X = 4791.244801771758830;
DGC5Sat.Y = 3981.843847094183275;
DGC5Sat.Z = 2653.334545050801353;
DGC5Sat.VX = -5.018943360359614;
DGC5Sat.VY = 2.567534615772381;
DGC5Sat.VZ = 5.209846002826843;
DGC5Sat.DryMass = 500;
DGC5Sat.Cd = 1.1;
DGC5Sat.Cr = 1.0;
DGC5Sat.DragArea = 4;
DGC5Sat.SRPArea = 4.0;
DGC5Sat.AtmosDensityScaleFactor = 1.0;

Create ForceModel DGC5GravityFM;
DGC5GravityFM.CentralBody = Earth;
DGC5GravityFM.PrimaryBodies = {Earth};
DGC5GravityFM.Drag = None;
DGC5GravityFM.SRP = Off;
DGC5GravityFM.RelativisticCorrection = Off;
DGC5GravityFM.ErrorControl = RSSStep;
DGC5GravityFM.GravityField.Earth.Degree = 20;
DGC5GravityFM.GravityField.Earth.Order = 20;
DGC5GravityFM.GravityField.Earth.PotentialFile = './data/reference/gmat_r2026a/JGM2.cof';
DGC5GravityFM.GravityField.Earth.TideModel = 'None';

Create ForceModel DGC5DragFM;
DGC5DragFM.CentralBody = Earth;
DGC5DragFM.PrimaryBodies = {Earth};
DGC5DragFM.Drag.AtmosphereModel = Exponential;
DGC5DragFM.Drag.DragModel = 'Spherical';
DGC5DragFM.Drag.InputFile = './data/reference/gmat_r2026a/EarthExponentialAtmosphereData.txt';
DGC5DragFM.SRP = Off;
DGC5DragFM.RelativisticCorrection = Off;
DGC5DragFM.ErrorControl = RSSStep;
DGC5DragFM.GravityField.Earth.Degree = 20;
DGC5DragFM.GravityField.Earth.Order = 20;
DGC5DragFM.GravityField.Earth.PotentialFile = './data/reference/gmat_r2026a/JGM2.cof';
DGC5DragFM.GravityField.Earth.TideModel = 'None';

Create Propagator DGC5Prop;
DGC5Prop.FM = DGC5GravityFM;
DGC5Prop.Type = PrinceDormand78;
DGC5Prop.InitialStepSize = 50;
DGC5Prop.Accuracy = 1e-13;
DGC5Prop.MinStep = 1e-06;
DGC5Prop.MaxStep = 50;
DGC5Prop.MaxStepAttempts = 50;
DGC5Prop.StopIfAccuracyIsViolated = true;

Create ReportFile DGC5Report;
DGC5Report.Filename = './data/reference/gmat_1e0/output/CD_HALF_DRAG_ACCELERATION_1E0.csv';
DGC5Report.Precision = 16;
DGC5Report.ColumnWidth = 24;
DGC5Report.WriteHeaders = true;
DGC5Report.LeftJustify = Off;
DGC5Report.ZeroFill = On;
DGC5Report.FixedWidth = Off;
DGC5Report.Delimiter = Comma;

BeginMissionSequence;
Report DGC5Report DGC5Sat.ElapsedSecs DGC5Sat.EarthMJ2000Eq.X DGC5Sat.EarthMJ2000Eq.Y DGC5Sat.EarthMJ2000Eq.Z DGC5Sat.EarthMJ2000Eq.VX DGC5Sat.EarthMJ2000Eq.VY DGC5Sat.EarthMJ2000Eq.VZ DGC5Sat.DGC5GravityFM.AccelerationX DGC5Sat.DGC5GravityFM.AccelerationY DGC5Sat.DGC5GravityFM.AccelerationZ DGC5Sat.DGC5DragFM.AccelerationX DGC5Sat.DGC5DragFM.AccelerationY DGC5Sat.DGC5DragFM.AccelerationZ;
Propagate DGC5Prop(DGC5Sat) {DGC5Sat.ElapsedSecs = 50};
Report DGC5Report DGC5Sat.ElapsedSecs DGC5Sat.EarthMJ2000Eq.X DGC5Sat.EarthMJ2000Eq.Y DGC5Sat.EarthMJ2000Eq.Z DGC5Sat.EarthMJ2000Eq.VX DGC5Sat.EarthMJ2000Eq.VY DGC5Sat.EarthMJ2000Eq.VZ DGC5Sat.DGC5GravityFM.AccelerationX DGC5Sat.DGC5GravityFM.AccelerationY DGC5Sat.DGC5GravityFM.AccelerationZ DGC5Sat.DGC5DragFM.AccelerationX DGC5Sat.DGC5DragFM.AccelerationY DGC5Sat.DGC5DragFM.AccelerationZ;
